# Токен бота Telegram от @BotFather (пусто — Telegram не запускается)
TG_BOT_TOKEN=
# Токен бота MAX из кабинета business.max.ru → Чат-боты (пусто — MAX не запускается)
MAX_BOT_TOKEN=
# Кто видит выгрузку и получает уведомления: tg:<id в Telegram>, max:<id в MAX>, через запятую
ADMINS=tg:123456789
